# ============================================================
# discovery-engine — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
#
#   cp .env.example .env
# ============================================================

# ── Groq (LLM inference) ─────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Apify (Reddit + Community scraping) ──────────────────────
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_your_token_here

# ── PostgreSQL Database ───────────────────────────────────────
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/discovery_engine

# ── Optional: SerpAPI (Play Store fallback) ──────────────────
# Only needed if google-play-scraper gets blocked
# Get your key at: https://serpapi.com/manage-api-key
SERP_API_KEY=

# ── Optional: OpenAI (upgrade embeddings from MiniLM to text-embedding-3-small)
# Leave blank to use local sentence-transformers (all-MiniLM-L6-v2) for free
OPENAI_API_KEY=

# ── Environment ───────────────────────────────────────────────
ENV=development   # development | production
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
